DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
GEMI_API_KEY=your-personal-gemi-api-key

# SMTP production example. EMAIL_BACKEND is chosen automatically from DJANGO_DEBUG (console
# in development, SMTP in production) — leave it unset here. Set it explicitly only to force
# real SMTP sends from a local run, e.g. to test the Brevo relay itself.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Gemi Leads <notifications@send.gemileads.gr>
EMAIL_REPLY_TO=info@gemileads.gr

# Shared secret Brevo appends to the webhook URL and sends back with every event delivery
# (Brevo's own "Token-based authentication" webhook option). Generate a long random value and
# configure the SAME value + URL (https://<domain>/api/brevo/webhook/<token>/) as a webhook
# destination in the Brevo dashboard under Transactional > Settings > Webhooks.
BREVO_WEBHOOK_TOKEN=replace-me
# Max cold-outreach emails to send per rolling 24h. Keep it below the Brevo plan's daily
# quota with headroom for digest emails (which share the same quota). Default 250.
OUTREACH_DAILY_SEND_CAP=250

# Beta flags.
# BETA_MODE shows the "Beta" label in the navigation and footer (label only, no behaviour change).
# LEGAL_BILLING_ACTIVE is the real switch: while it is 0 the app refuses to create any Stripe
# checkout session, server-side, and the pricing page renders no checkout buttons at all.
BETA_MODE=1

# Stripe (inert while LEGAL_BILLING_ACTIVE=0)
STRIPE_PUBLIC_KEY=pk_test_replace-me
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_PRO=price_replace-me
STRIPE_PRICE_BUSINESS=price_replace-me
STRIPE_PRICE_ENTERPRISE=price_replace-me

# Legal / imprint details. While LEGAL_CONTROLLER_NAME is empty, /privacy/ and /terms/ stay in
# draft: they show a warning and are noindex, so an unfinished policy is never published as binding.
LEGAL_CONTROLLER_NAME=
LEGAL_VAT=
LEGAL_GEMI=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_LAST_UPDATED=
# Set to 1 only once real payments are live, so the billing clauses replace the pre-launch notice.
LEGAL_BILLING_ACTIVE=0

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to disable analytics.
GA_MEASUREMENT_ID=

# Google Search Console verification (token value only, not the full meta tag).
# Leave empty if verifying by DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=

# Error tracking
SENTRY_DSN=

# Production only (DJANGO_DEBUG=0 turns on HTTPS redirect, HSTS and secure cookies)
DJANGO_CSRF_TRUSTED_ORIGINS=https://gemileads.gr,https://www.gemileads.gr

# Social login. A provider with no client_id renders no button, so either can be left empty.
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: https://gemileads.gr/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer -> Certificates, Identifiers & Profiles. Needs a paid account.
# APPLE_CLIENT_ID is the Services ID (e.g. gr.gemileads.web), NOT the App ID.
# Return URL: https://gemileads.gr/accounts/apple/login/callback/
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key file, newlines written as literal \n.
APPLE_PRIVATE_KEY=
