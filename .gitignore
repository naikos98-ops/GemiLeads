# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Django local state
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
~$*

# Node is used only to compile the Tailwind stylesheet; the lockfile and manifest are tracked
# so the Render build is reproducible, but the installed tree is not.
node_modules/

# Generated by `npm run build:css` during the build; never edit by hand.
static/css/app.css
